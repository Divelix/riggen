<?xml version="1.0" encoding="utf-8"?>
<!--
  The second half of the import corpus (ADR-0026): everything above is one
  model with `menagerie_style.xml`, which <include>s this file the way a
  Menagerie `scene.xml` includes its robot. It holds the <asset> block and
  the whole of the robot, under a <mujocoinclude> root — MuJoCo accepts any
  root tag for an included file, and this is the one it documents.

  The <frame> around <body name="upper"> carries that body's own `pos` and
  the `childclass` it already inherits, so the composed document is exactly
  the one this corpus pinned before the file was split: what the frame adds
  is that the pass has to fold it away and get the same numbers back.
-->
<mujocoinclude>
  <asset>
    <mesh name="base" file="base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="shoulder" file="shoulder.stl" scale="0.001 0.002 0.001"/>
    <mesh name="grip" file="thing.msh"/>
    <mesh name="pad" vertex="0 0 0  0.01 0 0  0 0.01 0  0 0 0.01"
          face="0 1 2  0 1 3  0 2 3  1 2 3"/>
    <material name="metal" rgba="0.5 0.5 0.55 1"/>
    <texture name="grid" type="2d" builtin="checker" width="8" height="8"/>
  </asset>

  <worldbody>
    <body name="base_link" childclass="arm">
      <inertial pos="0 0 0.02" mass="0.5" diaginertia="0.001 0.001 0.002"/>
      <geom class="arm_visual" mesh="base"/>
      <geom class="arm_collision" mesh="base" quat="0.7071068 0 0 0.7071068"/>
      <site name="mount" pos="0 0 0.03" euler="90 0 0"/>
      <body name="shoulder" pos="0 0 0.04" euler="0 0 45">
        <joint name="shoulder_pan" axis="0 0 1" ref="10"/>
        <inertial pos="0 0 0.03" mass="0.3" fullinertia="0.001 0.001 0.001 0 0 0"/>
        <geom class="arm_visual" mesh="shoulder"/>
        <geom class="arm_visual" mesh="grip"/>
        <geom class="arm_visual" mesh="pad"/>
        <camera name="wrist_cam" pos="0 0 0.1"/>
        <frame pos="0 0 0.055" childclass="arm">
          <body name="upper" axisangle="0 1 0 30">
            <joint name="shoulder_lift" axis="0 1 0" range="-90 90"/>
            <inertial pos="0 0 0.05" mass="0.2" diaginertia="0.001 0.001 0.001"/>
            <geom class="arm_collision" type="capsule" size="0.02" fromto="0 0 0 0 0 0.1"/>
            <body name="wrist" pos="0 0 0.1" xyaxes="1 0 0 0 0 1">
              <joint name="wrist_slide" type="slide" axis="0 0 1" range="0 0.05"/>
              <inertial pos="0 0 0.01" mass="0.05" diaginertia="0.0001 0.0001 0.0001"/>
              <geom class="arm_visual" type="box" size="0.01 0.02 0.03"/>
              <geom class="arm_collision" type="ellipsoid" size="0.01 0.02 0.03"/>
              <body name="tool" zaxis="0 -1 0">
                <site name="tcp" pos="0 0 0.02"/>
                <body name="finger" pos="0 0 0.03">
                  <joint name="finger_flex" axis="1 0 0" range="-30 30"/>
                  <inertial pos="0 0 0.01" mass="0.02" diaginertia="1e-5 1e-5 1e-5"/>
                  <geom class="arm_visual" mesh="pad"/>
                </body>
              </body>
            </body>
          </body>
        </frame>
      </body>
    </body>
  </worldbody>
</mujocoinclude>
