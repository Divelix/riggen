<?xml version="1.0" encoding="utf-8"?>
<!--
  Not written by riggen: the corpus for the MJCF import (ADR-0015), shaped
  like a MuJoCo Menagerie model rather than like our own export. It carries,
  on purpose, everything the import has to cope with and everything it has
  to refuse to guess at:

    * <compiler angle="degree">, which is MJCF's default and the opposite
      of ours, plus a meshdir pointing at the arm fixture's own meshes;
    * a <default> tree with a childclass on the root body, class names that
      are not our "visual" / "collision", and gains inherited two levels up;
    * all five spellings of a rotation — quat, euler, axisangle, xyaxes,
      zaxis — one per element;
    * a <geom fromto> capsule, a non-uniform mesh scale, an ellipsoid and a
      primitive on the visual side;
    * a <mesh file=".msh"> (MuJoCo's own binary format) and an inline
      <mesh vertex face>, both read as ordinary meshes (docs/plans/
      mjcf-mesh-geometry.md);
    * a <general> actuator whose gains come from a <default class> two
      levels up and whose gear from one level up (ADR-0024), and one
      driving a tendon;
    * a <tendon><fixed> over two joints with a range, passive dynamics and
      a springlength the document counts rather than keeps (ADR-0025 §4),
      driven by that <motor> (the <spatial> the import drops by name is a
      unit test's, not this file's: MuJoCo has to load what comes back);
    * a **mimic chain**: finger_flex follows shoulder_lift, which follows
      shoulder_pan (ADR-0025 §1), so the composed reach is 0.125 of the
      pan's ±180° and fits the finger's own ±30°;
    * a <joint ref> on the pan (ADR-0025 §3): its range is in qpos terms
      and the equality over it is in deviations from qpos0 = ref, both of
      which the re-export has to say back in MuJoCo's own words;
    * an <actuator> named something other than its joint, and a second one
      on that already-driven joint — both of which the document keeps
      (ADR-0023) — the second with an explicit ctrllimited="false" beside
      a ctrlrange (ADR-0024);
    * <option>, <light>, <camera>, <texture>, <material>, <sensor>,
      <contact> and <keyframe>, none of which the document holds;
    * **composition** (ADR-0026): the <asset> and the whole robot live in a
      sibling `menagerie_style_arm.xml` this file <include>s, the way a
      Menagerie `scene.xml` includes its robot, and a <frame> in there wraps
      a body with a joint in it. Both are resolved before the reader looks,
      so the document — and every warning below — is the one this file
      pinned when it was flat.

  `mjcf_in::tests::the_menagerie_style_corpus_imports_with_the_warnings_it_should`
  pins what comes of all that, warning by warning.
-->
<mujoco model="menagerie_style">
  <compiler angle="degree" eulerseq="xyz" meshdir="arm" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <default>
    <geom contype="1" conaffinity="1" solref="0.004 1"/>
    <joint damping="0.1" armature="0.01" frictionloss="0.02"/>
    <default class="arm">
      <joint range="-180 180"/>
      <general gaintype="fixed" gainprm="150" biastype="affine" biasprm="0 -150 -3"/>
      <default class="arm_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" rgba="0.2 0.2 0.25 1"/>
      </default>
      <default class="arm_collision">
        <geom type="mesh" group="3"/>
      </default>
      <default class="arm_drive">
        <general gear="2"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 2"/>
  </worldbody>

  <include file="menagerie_style_arm.xml"/>

  <equality>
    <joint joint1="shoulder_lift" joint2="shoulder_pan" polycoef="0 0.25 0 0 0"/>
    <joint joint1="finger_flex" joint2="shoulder_lift" polycoef="0 0.5 0 0 0"/>
  </equality>

  <actuator>
    <position name="pan" joint="shoulder_pan" kp="120" kv="12" forcerange="-30 30"/>
    <velocity name="pan_damp" joint="shoulder_pan" kv="3" ctrllimited="false" ctrlrange="-2 2"/>
    <general name="lift" joint="wrist_slide" class="arm_drive" dyntype="filter" dynprm="0.02"/>
    <motor name="grip" tendon="grip_tendon" gear="80"/>
  </actuator>

  <tendon>
    <fixed name="grip_tendon" range="-0.06 0.06" stiffness="20" damping="0.5" springlength="0.01">
      <joint joint="wrist_slide" coef="1"/>
      <joint joint="finger_flex" coef="-0.02"/>
    </fixed>
  </tendon>
  <sensor>
    <jointpos joint="shoulder_pan"/>
  </sensor>
  <contact>
    <exclude body1="base_link" body2="shoulder"/>
  </contact>
  <keyframe>
    <key name="home" qpos="0 0 0"/>
  </keyframe>
</mujoco>
