/target
# `uv build` output: the wheel and the sdist.
/dist
# `web/build.sh` output: the wasm-bindgen bundle plus the page beside it.
/web/dist
/python/**/*.so
# maturin's wheel data directory (pyproject.toml): `python/build_wheel.py`
# copies the built `riggen` binary into its `scripts/` for the wheel.
/riggen._riggen.data
/python/build
# `uv` resolving the root `pyproject.toml` as a project writes this. It locks
# nothing — riggen declares no Python dependencies — and no tool reads it: the
# `mujoco` CI job passes `--no-project` precisely to skip that path.
/uv.lock

# Personal notebooks on the dev build (README §Developing).
/scratch
__pycache__/
.venv/

# `egui_kittest` writes these next to the committed snapshot goldens on every
# failing or updated run (ADR-0003). The `.png` goldens themselves are tracked.
*.new.png
*.diff.png
*.old.png
*.json.new
